function filterInventory(search){

search=search.toLowerCase();


const filtered=
products.filter(function(product){

return(

String(product.code)
.toLowerCase()
.includes(search)

||

String(product.name)
.toLowerCase()
.includes(search)

||

String(product.category)
.toLowerCase()
.includes(search)

);

});


renderInventory(filtered);

}


